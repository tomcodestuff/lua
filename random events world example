events.Convo = {weight = 3, run = function(ctx)
	local spot = sidewalkSpot(ctx:pos(), 25, 90)
	if not spot then return false end
	local a = spawnNpc("Regular", spot + Vector3.new(-1.4, 0, 0))
	local b = spawnNpc(pick({"Drunk", "Regular", "Coward"}), spot + Vector3.new(1.4, 0, 0))
	if not a or not b then return false end
	ctx:track(a)
	ctx:track(b)
	local lines = pick(CONVOS)
	for i, line in ipairs(lines) do
		local speaker, listener = a, b
		if i % 2 == 0 then speaker, listener = b, a end
		if not (speaker.Parent and listener.Parent) then break end
		face(speaker, listener:GetPivot().Position)
		face(listener, speaker:GetPivot().Position)
		anim(listener, nil)
		anim(speaker, "Argue")
		say(speaker, line, 3.2)
		if not ctx:wait(3.6) then break end
	end
	anim(a, nil)
	anim(b, nil)
	return true
end}

events.Fire = {weight = 1.5, run = function(ctx)
	local ignite = ServerScriptService:FindFirstChild("IgniteTarget")
	if not ignite then return false end
	local here = ctx:pos()
	local options = {}
	for _, thing in ipairs(CollectionService:GetTagged("Flammable")) do
		if thing.Parent and not thing:GetAttribute("Burning") and not thing:GetAttribute("Charred") then
			local part = thing:IsA("BasePart") and thing or thing:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local d = flat(part.Position - here).Magnitude
				if d > 55 and d < 170 and not (Visibility and Visibility.seen(part.Position)) then table.insert(options, thing) end
			end
		end
	end
	if #options == 0 then return false end
	local target = pick(options)
	local part = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
	ignite:Fire(target)
	if Alert then Alert.makeNoise(part.Position, 45, "flee") end
	ctx:hint(part.Position, 190, "You smell smoke. Something is on fire nearby.")
	ctx:wait(40)
	return true
end}

local function recogniseMood(player)
	local standing = player:GetAttribute("RepStanding") or 0
	local fame = player:GetAttribute("RepFame") or 0
	local title = player:GetAttribute("RepTitle") or "Nobody"
	local heat = Heat and Heat.getLevel and Heat.getLevel(player) or 0
	if heat >= 1 then return "wanted", title end
	if standing >= 35 then return "fan", title end
	if standing <= -35 then return "afraid", title end
	if fame >= 300 and title ~= "Nobody" then return "known", title end
	return nil, title
end
events.Recognised = {weight = 2.5, run = function(ctx)
	local mood, title = recogniseMood(ctx.player)
	if not mood then return false end
	local playerPos = ctx:pos()
	local spot = sidewalkSpot(playerPos, 35, 80)
	if not spot then return false end
	local npc = spawnNpc(pick({"Regular", "Drunk", "Coward"}), spot, playerPos)
	if not npc then return false end
	ctx:track(npc)
	local hum, root = humOf(npc), hrpOf(npc)
	if not hum or not root then return false end
	hum.WalkSpeed = 13

	local arrived = false
	local started = os.clock()
	while os.clock() - started < 30 and ctx:alive() and npc.Parent do
		local p = ctx:pos()
		if not p then break end
		if (p - root.Position).Magnitude < 7 then arrived = true break end
		hum:MoveTo(p)
		ctx:wait(0.4)
	end
	if not arrived then return true end
	hum:MoveTo(root.Position)
	face(npc, ctx:pos())

	if mood == "wanted" then
		anim(npc, "Shout")
		say(npc, "Hang on... you're the one the police are after!", 3.5)
		ctx:wait(2.2)
		anim(npc, nil)
		say(npc, "HELP! POLICE! He's over here!", 3)
		if Alert then Alert.crime(ctx.player, 1, playerPos) end
		flee(npc, ctx:pos() or root.Position, 120, 22)
	elseif mood == "fan" then
		anim(npc, "Cheer")
		say(npc, "It's you! The " .. title .. "! You're a legend round here!", 4)
		ctx:wait(2.8)
		anim(npc, nil)
		local reward = math.random(5, 25)
		local cash = ctx.player:FindFirstChild("Cash")
		if cash then cash.Value += reward end
		say(npc, "Here, get yourself something to eat.", 3)
		notify(ctx.player, "A fan recognised you and slipped you $" .. reward)
	elseif mood == "afraid" then
		anim(npc, "HandsUp")
		say(npc, "Oh no... it's the " .. title .. ". Please, stay away from me!", 3.5)
		ctx:wait(2.5)
		anim(npc, nil)
		flee(npc, ctx:pos() or root.Position, 120, 20)
	else
		anim(npc, "Argue")
		say(npc, "Oi, you're that " .. title .. ", aren't you?", 3.5)
		ctx:wait(3)
		say(npc, "Respect.", 2)
		ctx:wait(2)
		anim(npc, nil)
	end
	ctx:wait(6)
	return true
end}

local busy = {}
local nextAt = {}
local active = 0

local function runEvent(player, name, forced)
	local event = events[name]
	if not event or busy[player] then return end
	local ctx = makeContext(player)
	busy[player] = true
	active += 1
	task.spawn(function()
		local ok, result = pcall(event.run, ctx)
		if not ok then warn("[RandomEvents] " .. name .. ": " .. tostring(result)) end
		ctx:finish()
		busy[player] = nil
		active -= 1
		if ok and result == false and not forced then nextAt[player] = os.clock() + 12 end
		if forced then print("[RandomEvents] " .. name .. " finished (" .. tostring(ok and result) .. ")") end
	end)
end

local function chooseEvent(player)
	local total = 0
	local list = {}
	for name, event in pairs(events) do
		local usable = true
		if name == "CarCrash" and not (Vehicles and RoadNetwork) then usable = false end
		if usable then
			total += event.weight
			table.insert(list, {name, event.weight})
		end
	end
	local r = math.random() * total
	for _, entry in ipairs(list) do
		r -= entry[2]
		if r <= 0 then return entry[1] end
	end
	return list[1] and list[1][1]
end

local function eligible(player)
	if busy[player] or not rootOf(player) then return false end
	if player:GetAttribute("Cuffed") or player:GetAttribute("Sleeping") or player:GetAttribute("Driving") then return false end
	if Heat and Heat.getLevel and Heat.getLevel(player) >= 4 then return false end
	return true
end

task.spawn(function()
	while true do
		task.wait(5)
		if active < MAX_ACTIVE then
			for _, player in ipairs(Players:GetPlayers()) do
				if eligible(player) then
					if not nextAt[player] then nextAt[player] = os.clock() + FIRST_EVENT_DELAY end
					if os.clock() >= nextAt[player] then
						nextAt[player] = os.clock() + math.random(MIN_GAP, MAX_GAP)
						local name = chooseEvent(player)
						if name then runEvent(player, name, false) end
					end
				else
					nextAt[player] = nil
				end
			end
		end
	end
end)

workspace:GetAttributeChangedSignal("ForceEvent"):Connect(function()
	local name = workspace:GetAttribute("ForceEvent")
	if not name or name == "" then return end
	workspace:SetAttribute("ForceEvent", nil)
	local player = Players:GetPlayers()[1]
	if player and events[name] then
		print("[RandomEvents] forcing " .. name)
		busy[player] = nil
		runEvent(player, name, true)
	else
		warn("[RandomEvents] unknown event or no player: " .. tostring(name))
	end
end)

