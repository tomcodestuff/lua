local function optional(parent, name)
	local module = parent:FindFirstChild(name) or parent:WaitForChild(name, 8)
	if not module then return nil end
	local ok, result = pcall(require, module)
	if not ok then warn("[RandomEvents] " .. name .. " failed: " .. tostring(result)) return nil end
	return result
end

