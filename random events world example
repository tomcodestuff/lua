local SPAWN_RANGE: number = 130    -- spawn homes whose pivot is closer than this to a player
local DESPAWN_RANGE: number = 300  -- despawn beyond this (gap > spawn range = hysteresis, no flicker)
local SIT_LIFT: number, LIE_LIFT: number = 0.95, 0.55 -- HumanoidRootPart height above seat top / mattress top

local residents: {[Model]: ResidentState} = {} -- [npc] = state
local folder: Folder?

