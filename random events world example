-- The people who live in the houses. They are spawned when a player comes near a furnished house, go about their day
-- (watch TV, eat, cook, use the toilet, sleep in their bed, chat with each other, step outside) and despawn when nobody
-- is near. Their fighting is the ordinary "Regular" brain (see the Resident template); this module is their daily life:
--   * Life.start(npc, provoke) runs their routine and watches for strangers in their home (then they shout and attack)
--   * Life.wake(npc) gets one out of bed / off the sofa / off the toilet at once

-- ===== services =====
local Players: Players = game:GetService("Players")
local PathfindingService: PathfindingService = game:GetService("PathfindingService") -- navmesh agent paths (ComputeAsync)
local CollectionService: CollectionService = game:GetService("CollectionService")     -- tags ("Posed", "HouseDoor", "Bartender")
local ServerScriptService: ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage: ServerStorage = game:GetService("ServerStorage")                 -- NPCTemplates live here (never replicated)
local HttpService: HttpService = game:GetService("HttpService")                       -- only used for JSONDecode

-- ===== types =====
-- Roles and activities are string literal unions so a typo ("sleeping") is a type error instead of a silent bug.
type ResidentRole = "landlord" | "guest" | "bartender"
type Activity = "tv" | "eat" | "toilet" | "pub" | "sleep" | "cook" | "wander" | "chat" | "bartend" | "outside"
type PoseName = "Sit" | "Lie"

-- one room of a home, in WORLD space (decoded from the house's RoomsJson attribute by roomsOf)
type Room = {
	type: string,
	floor: number,    -- 0 = ground, 1 = upstairs
	centre: Vector3,  -- world-space centre of the room floor
	w: number,        -- width along house X, already multiplied by HouseScale
	d: number,        -- depth along house Z, already multiplied by HouseScale
}

-- the raw JSON shape stored in the "RoomsJson" attribute (house-local coordinates)
type RoomJson = {type: string, floor: number, x0: number, x1: number, y: number, z0: number, z1: number}
type RoomsPayload = {rooms: {RoomJson}}

-- furniture grouped by prop name ("Sofa", "Single Bed" ...)
type PropMap = {[string]: {Model}}

-- per-resident runtime state, keyed by NPC model in `residents`
type ResidentState = {
	house: Model,
	unit: number,                      -- which home of a terrace (a house can contain several "Units")
	role: ResidentRole,
	props: PropMap,
	rooms: {Room},
	upstairs: boolean?,                -- true for the pub-lounge staff
	zone: BasePart?,                   -- the PowerZone part covering this home's rooms
	seen: {[Player]: number},          -- seconds-ish of line of sight per player (notice timer)
	roomCentreOf: ((pos: Vector3) -> Vector3?)?,
	activity: Activity?,
	floorOnly: number?,                -- restricts firstOf() to props on that floor
	chatting: boolean?,
	reactedToDark: boolean?,
	gone: boolean?,                    -- set when the NPC is destroyed; every loop checks it
	-- seat/bed state:
	placed: boolean?,                  -- HumanoidRootPart is anchored on a seat/bed
	posed: boolean?,                   -- "Pose" attribute + "Posed" tag are applied
	exit: CFrame?,                     -- where to put him when he gets up
}

type Activity_fn = (npc: Model, S: ResidentState) -> boolean
type WeightedActivity = {number | Activity_fn}  -- {weight, fn}; kept as a loose array to mirror the original

-- Soft dependencies (loaded with safeRequire so a missing module never breaks the residents)
type SpeechModule = { say: (npc: Model, text: string) -> () }
type AlertModule = {
	canSee: (observer: Model, target: Model, range: number) -> boolean, -- line-of-sight style check
	crime: (player: Player, heat: number, position: Vector3) -> (),     -- raises police heat at a position
}
type OccupancyModule = {
	add: (prop: Instance, npc: Model, onEvicted: (npc: Model) -> ()) -> (),
	remove: (npc: Model) -> (),
	occupantsOf: (prop: Instance) -> {Model},
}

type LifeModule = {
	residents: {[Model]: ResidentState},
	release: (npc: Model, keepPlace: boolean?) -> (),
	wake: (npc: Model) -> (),
	start: (npc: Model, provoke: (char: Model) -> ()) -> (),
	spawn: (house: Model, unit: number, role: ResidentRole, upstairs: boolean?) -> Model?,
	manager: () -> (),
}

-- require() can throw, so it is wrapped in pcall. Return type is `any` because the module shape is only known by contract.
local function safeRequire(name: string): any
	local module = ServerScriptService:WaitForChild(name, 10) -- yields up to 10s, returns nil on timeout
	if not module then return nil end
	local ok, result = pcall(require, module :: ModuleScript)
	return ok and result or nil
end
local Speech = safeRequire("Speech") :: SpeechModule?
local Alert = safeRequire("CombatAlert") :: AlertModule?
local Occupancy = safeRequire("Occupancy") :: OccupancyModule?

local Life = {} :: LifeModule -- cast the empty table; the fields are filled in below

-- ===== tuning (studs) =====
