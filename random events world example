-- Generic helper: the type parameter T keeps the element type, so pick(TV) is a string and pick(PAIRS) is {string}.
local function pick<T>(list: {T}): T return list[math.random(#list)] end -- math.random(n) is inclusive 1..n

local function say(npc: Model, text: string)
	if Speech and npc.Parent then Speech.say(npc, text) end
end

-- Distance on the XZ plane only. Vector3 * Vector3 multiplies component-wise, so (1,0,1) zeroes the height difference.
local function flat(a: Vector3, b: Vector3): number
	return ((a - b) * Vector3.new(1, 0, 1)).Magnitude
end

local function alive(npc: Model): boolean
	local hum = npc.Parent and npc:FindFirstChildOfClass("Humanoid") -- nil if the NPC was destroyed/unparented
	return hum ~= nil and hum.Health > 0
end

-- fighting, grabbed, carried or ragdolled: the routine stands aside
-- Attributes are replicated, Variant-typed values; they are truthy-checked here, so the return is loosely typed.
local function busy(npc: Model): any
	return npc:GetAttribute("Aggro") or npc:GetAttribute("Held") or npc:GetAttribute("Carried") or npc:GetAttribute("Ragdolled")
end

local function aborted(npc: Model): boolean
	local S = residents[npc]
	return not S or S.gone == true or not alive(npc) or busy(npc) ~= nil and busy(npc) ~= false
end

-- ===== the home =====
-- Returns the house's pivot lowered slightly, plus its scale.
-- CFrame multiplication applies the right-hand offset in the LEFT frame's local space, so -0.3*scale moves along the
-- house's own Y axis, not world Y (matters if a house is ever rotated).
local function originOf(house: Model): (CFrame, number)
	local scale = (house:GetAttribute("HouseScale") :: number?) or 1
	return house:GetPivot() * CFrame.new(0, -0.3 * scale, 0), scale
end

-- Casts a ray straight down to find the floor height under `pos`.
-- Raycast(origin, direction, params): `direction` is a displacement vector (length = max distance), NOT a unit vector.
-- Starts 3 studs above pos and searches 14 studs down, so it can find a floor even if pos is slightly below it.
local function floorAt(pos: Vector3, ignore: {Instance}): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude -- ignore the NPC and furniture so we hit the floor itself
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), params)
	return hit and hit.Position.Y or pos.Y -- RaycastResult | nil; fall back to the given height
end

-- Finds the invisible "PowerZone" box part that covers one home of a terrace (matched through its Group attribute).
local function zoneFor(house: Model, unit: number): BasePart?
	local group = house.Name .. "#" .. unit
	for _, z in ipairs(house:GetChildren()) do
		if z.Name == "PowerZone" and z:GetAttribute("Group") == group then return z :: BasePart end
	end
	return nil
end

-- Oriented-box point test. PointToObjectSpace converts a world point into the zone's local frame, so the zone can be
-- rotated and the test stays a simple axis-aligned comparison against half the Size on each axis.
local function inZone(zone: BasePart?, position: Vector3): boolean
	if not zone then return false end
	local lp = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(lp.X) <= half.X and math.abs(lp.Y) <= half.Y and math.abs(lp.Z) <= half.Z
end

-- the furniture of one home, grouped by kind
local function gather(house: Model, unit: number): PropMap
	local props: PropMap = {}
	local furniture = house:FindFirstChild("Furniture")
	if furniture then
		for _, prop in ipairs(furniture:GetChildren()) do
			if prop:GetAttribute("Unit") == unit then
				props[prop.Name] = props[prop.Name] or {}
				table.insert(props[prop.Name], prop :: Model)
			end
		end
	end
	return props
end

local function roomsOf(house: Model, unit: number): {Room}
	local rooms: {Room} = {}
	-- JSONDecode throws on invalid JSON (or on a nil attribute), hence the pcall
	local ok, data = pcall(function(): RoomsPayload
		return HttpService:JSONDecode(house:GetAttribute("RoomsJson") :: string)
	end)
	if not ok then return rooms end
	local origin, scale = originOf(house)
	local zone = zoneFor(house, unit)
	for _, r in ipairs((data :: RoomsPayload).rooms) do
		-- CFrame * Vector3 is CFrame:PointToWorldSpace: house-local room centre -> world position
		local centre = origin * Vector3.new((r.x0 + r.x1) / 2 * scale, r.y * scale, (r.z0 + r.z1) / 2 * scale)
		-- keep only rooms inside this unit's power zone (nudged up 3 studs so the floor point is inside the box)
		if not zone or inZone(zone, centre + Vector3.new(0, 3, 0)) then
			table.insert(rooms, {type = r.type, floor = r.floor, centre = centre,
				w = (r.x1 - r.x0) * scale, d = (r.z1 - r.z0) * scale})
		end
	end
	return rooms
end

-- ===== moving about =====
-- Yields. Returns true if the NPC ended up within ~4.5 studs (XZ) of `target`.
local function walkTo(npc: Model, target: Vector3): boolean
	local hum = npc:FindFirstChildOfClass("Humanoid")
	local hrp = npc:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp then return false end
	if flat(hrp.Position, target) < 2.5 and math.abs(hrp.Position.Y - target.Y) < 5 then return true end

	-- agent dimensions must fit doorways and furniture gaps; AgentCanJump allows jump waypoints (stairs, kerbs)
	local path = PathfindingService:CreatePath({AgentRadius = 1.7, AgentHeight = 5.2, AgentCanJump = true, WaypointSpacing = 5})
	local ok = pcall(function() path:ComputeAsync(hrp.Position, target) end) -- ComputeAsync yields and can throw
	local started = os.clock() -- os.clock is a high-resolution monotonic timer, good for elapsed time
	if ok and path.Status == Enum.PathStatus.Success then
		for _, wp in ipairs(path:GetWaypoints()) do -- {PathWaypoint}: Position + Action
			if aborted(npc) then return false end
			if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
			hum:MoveTo(wp.Position) -- non-blocking; Humanoid walks toward it (MoveTo times out after 8s)
			local t = os.clock()
			while flat(hrp.Position, wp.Position) > 2.3 and os.clock() - t < 3 do
				if aborted(npc) then return false end
				task.wait(0.1)
			end
			if os.clock() - started > 45 then break end -- never spend longer than 45s on one trip
		end
	else
		-- no navmesh route: walk in a straight line and hope
		hum:MoveTo(target)
		local t = os.clock()
		while flat(hrp.Position, target) > 2.5 and os.clock() - t < 6 do
			if aborted(npc) then return false end
			task.wait(0.1)
		end
	end
	return flat(hrp.Position, target) < 4.5
end

-- NOTE: this local shadows the global `wait`. It is an "idle for N seconds, speaking now and then" helper.
-- Returns false if the routine was aborted early (so callers can bail out).
local function wait(npc: Model, seconds: number, lines: {string}?, every: number?): boolean
	local t = os.clock()
	local nextLine = os.clock() + (every or 9) * (0.5 + math.random()) -- math.random() is a float in [0,1)
	while os.clock() - t < seconds do
		if aborted(npc) then return false end
		if lines and os.clock() >= nextLine then
			say(npc, pick(lines))
			nextLine = os.clock() + (every or 9) * (0.7 + math.random())
		end
		task.wait(0.25)
	end
	return true
end

-- ===== sitting and lying =====
-- Frees a seated/lying NPC. keepPlace = true leaves him where he is (used when Occupancy evicts him).
function Life.release(npc: Model, keepPlace: boolean?)
	local S = residents[npc]
	if not S then return end
	if Occupancy then Occupancy.remove(npc) end
	if S.posed then
		S.posed = false
		npc:SetAttribute("Pose", nil) -- setting an attribute to nil removes it
	end
	local hrp = npc:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp and S.placed then
		S.placed = false
		hrp.Anchored = false -- physics takes over again
		if not keepPlace and S.exit then
			hrp.CFrame = S.exit
			hrp.AssemblyLinearVelocity = Vector3.zero -- kill any leftover momentum (replaces the deprecated .Velocity)
		end
	end
	S.exit = nil
end

function Life.wake(npc: Model) -- called when he is provoked, hit, grabbed...
	Life.release(npc, false)
end

-- recursive = true: finds a named part anywhere below `prop`, not just a direct child
local function partOf(prop: Instance, name: string): BasePart?
	return prop:FindFirstChild(name, true) :: BasePart?
end

-- Builds the CFrame the HumanoidRootPart should have while seated.
-- The NPC faces AWAY from the backrest (seat - back, flattened onto XZ), or toward `hint` if the seat has no back.
local function sitCFrame(prop: Model, kind: string, hint: Vector3?): CFrame?
	local seat: BasePart?, back: BasePart?
	if kind == "Toilet" then
		seat, back = partOf(prop, "Seat"), partOf(prop, "Tank")
	elseif kind == "Sofa" then
		local cushions: {BasePart} = {}
		for _, d in ipairs(prop:GetDescendants()) do if d.Name == "Cushion" then cushions[#cushions + 1] = d :: BasePart end end
		seat, back = cushions[math.random(math.max(#cushions, 1))], partOf(prop, "Back") -- random cushion; max() avoids random(0)
	elseif kind == "Armchair" then
		seat, back = partOf(prop, "Cushion"), partOf(prop, "Back")
	elseif kind == "Chair" then
		seat, back = partOf(prop, "Seat"), partOf(prop, "Back")
	elseif kind == "Bar Stool" then
		seat = partOf(prop, "Seat")
	end
	if not seat then return nil end
	local face: Vector3?
	if back then
		face = Vector3.new(seat.Position.X - back.Position.X, 0, seat.Position.Z - back.Position.Z)
	elseif hint then
		face = Vector3.new(hint.X - seat.Position.X, 0, hint.Z - seat.Position.Z)
	end
	if not face or face.Magnitude < 0.05 then return nil end -- degenerate: seat and back at the same spot
	face = face.Unit
	local top = seat.Position.Y + seat.Size.Y / 2 -- top surface of the seat part
	local pos = Vector3.new(seat.Position.X, top + SIT_LIFT, seat.Position.Z) - (back and face * 0.25 or Vector3.zero) -- nudge into the seat back
	return CFrame.lookAt(pos, pos + face) -- position + orientation looking along `face` with world-up as the up hint
end

-- Builds the CFrame for lying on a bed. Head direction h = footboard -> headboard (flattened, unit).
local function lieCFrame(prop: Model): CFrame?
	local mat, head, foot = partOf(prop, "Mattress"), partOf(prop, "Headboard"), partOf(prop, "Footboard")
	if not (mat and head and foot) then return nil end
	local h = Vector3.new(head.Position.X - foot.Position.X, 0, head.Position.Z - foot.Position.Z)
	if h.Magnitude < 0.05 then return nil end
	h = h.Unit
	local pos = mat.Position + Vector3.new(0, mat.Size.Y / 2 + LIE_LIFT, 0) + h * 0.4
	-- CFrame.fromMatrix(pos, xAxis, yAxis, zAxis) builds a rotation from three basis vectors (zAxis is optional only when
	-- the other two give a right-handed frame). Here: X = h rotated 90 deg about Y, Y(up of the character) = h,
	-- Z = world down. Roblox characters look along -Z, so LookVector = world UP: he lies on his back, head toward h.
	-- Check: X cross Y = (0,-1,0) = Z, so the basis is right-handed (a valid rotation, no mirroring).
	return CFrame.fromMatrix(pos, Vector3.new(h.Z, 0, -h.X), h, Vector3.new(0, -1, 0))
end

-- walks to the prop, then sits or lies on it. Returns true once he is in place.
local function settle(npc: Model, S: ResidentState, prop: Model, kind: string, pose: PoseName, lines: {string}?): boolean
	local cf: CFrame?, approach: Vector3?, exit: Vector3?
	local hint: Vector3?
	if kind == "Bar Stool" then
		local bar = S.props["Bar Counter"] and S.props["Bar Counter"][1]
		hint = bar and bar:GetPivot().Position -- stools face the bar counter (they have no backrest part)
	end
	if pose == "Lie" then
		cf = lieCFrame(prop)
		if cf then
			-- Pick the side of the bed the NPC stands on: Dot > 0 means the prop centre is on the +Right side,
			-- so the exit point goes to the opposite (-Right) side.
			local across = cf.RightVector
			local side = (prop:GetPivot().Position - cf.Position)
			local out = across * (side:Dot(across) > 0 and -1 or 1)
			approach = cf.Position + out * 3.4
			exit = cf.Position + out * 3.4
		end
	else
		cf = sitCFrame(prop, kind, hint)
		if cf then
			approach = cf.Position + cf.LookVector * 2.8 -- stand in front of the seat first
			exit = approach
		end
	end
	if not cf or not approach or not exit then return false end
	local ignore: {Instance} = {npc, prop.Parent :: Instance}
	approach = Vector3.new(approach.X, floorAt(approach, ignore) + 3.2, approach.Z) -- snap to the floor (+3.2 = root height)
	exit = Vector3.new(exit.X, approach.Y, exit.Z)
	if not walkTo(npc, approach) then return false end
	if aborted(npc) then return false end

	local hum = npc:FindFirstChildOfClass("Humanoid") :: Humanoid
	local hrp = npc:FindFirstChild("HumanoidRootPart") :: BasePart
	hum:MoveTo(hrp.Position)                    -- cancels any walk in progress
	hrp.AssemblyLinearVelocity = Vector3.zero   -- zero linear velocity of the whole assembly
	hrp.Anchored = true                         -- frozen by the engine: no physics, no Humanoid pushing him off the seat
	hrp.CFrame = cf                             -- teleport onto the seat/bed (anchored parts keep this exactly)
	S.placed = true
	-- CFrame.new(pos) * rotation: `cf.Rotation` is the CFrame with the translation stripped (pure rotation).
	-- Lying: stand up facing +90 deg about Y relative to the bed axis; sitting: keep the seat's facing.
	S.exit = CFrame.new(exit) * (pose == "Lie" and CFrame.Angles(0, math.rad(90), 0) or cf.Rotation)
	-- sitting and lying are poses played on him (arms down, nothing else moving; sitting also looks around)
	CollectionService:AddTag(npc, "Posed")
	npc:SetAttribute("Pose", pose)
	S.posed = true
	if Occupancy then Occupancy.add(prop, npc, function(n: Model) Life.release(n, true) end) end
	return true
end

-- ===== activities =====
-- Weighted random pick. `list` is {{weight, fn}, ...}; the cumulative-subtract loop is the standard roulette-wheel method.
local function choose(list: {{any}}): Activity_fn
	local total = 0
	for _, e in ipairs(list) do total += e[1] :: number end
	local r = math.random() * total
	for _, e in ipairs(list) do
		r -= e[1] :: number
		if r <= 0 then return e[2] :: Activity_fn end
	end
	return (list[1] and list[1][2]) :: Activity_fn
end

-- Picks a random FREE prop of any of the given names (on S.floorOnly if set). Returns the prop and the name it matched.
local function firstOf(S: ResidentState, ...: string): (Model?, string?)
	local options: {{any}} = {}
	for _, name in ipairs({...}) do
		for _, p in ipairs(S.props[name] or {}) do
			if p.Parent and (not S.floorOnly or p:GetAttribute("Floor") == S.floorOnly) and (not Occupancy or #Occupancy.occupantsOf(p) == 0) then
				options[#options + 1] = {p, name}
			end
		end
	end
	if #options == 0 then return nil end
	local o = options[math.random(#options)]
	return o[1] :: Model, o[2] :: string
end

local function doSit(npc: Model, S: ResidentState, kinds: {string}, label: Activity, lines: {string}?, secondsRange: {number}): boolean
	local prop, kind = firstOf(S, table.unpack(kinds)) -- table.unpack spreads the array into varargs
	if not prop or not kind then return false end
	S.activity = label
	if settle(npc, S, prop, kind, "Sit") then
		wait(npc, math.random(secondsRange[1], secondsRange[2]), lines, 8)
	end
	Life.release(npc, false)
	return true
end

local function actTV(npc: Model, S: ResidentState): boolean return doSit(npc, S, {"Sofa", "Armchair"}, "tv", TV, {35, 90}) end
local function actEat(npc: Model, S: ResidentState): boolean return doSit(npc, S, {"Chair"}, "eat", EAT, {20, 45}) end
local function actToilet(npc: Model, S: ResidentState): boolean return doSit(npc, S, {"Toilet"}, "toilet", nil, {12, 28}) end
local function actPub(npc: Model, S: ResidentState): boolean return doSit(npc, S, {"Bar Stool", "Chair"}, "pub", PUB, {30, 80}) end
-- the lounge upstairs: sit on its chairs and sofas only
local function actLounge(npc: Model, S: ResidentState): boolean
	S.floorOnly = 1
	local ok = doSit(npc, S, {"Chair", "Sofa", "Armchair"}, "pub", PUB, {40, 110})
	S.floorOnly = nil
	return ok
end

local function actSleep(npc: Model, S: ResidentState): boolean
	local prop = firstOf(S, "Single Bed", "Double Bed")
	if not prop then return false end
	S.activity = "sleep"
	if settle(npc, S, prop, "Bed", "Lie") then
		wait(npc, math.random(50, 120), SLEEP, 14)
	end
	Life.release(npc, false)
	return true
end

local function actCook(npc: Model, S: ResidentState): boolean
	local prop = firstOf(S, "Cooker", "Kitchen Unit", "Fridge")
	if not prop then return false end
	S.activity = "cook"
	local pos = prop:GetPivot().Position
	local toward = (S.roomCentreOf and S.roomCentreOf(pos)) or pos -- face into the room, so he stands in front of the cooker
	local dir = Vector3.new(toward.X - pos.X, 0, toward.Z - pos.Z)
	dir = dir.Magnitude > 0.5 and dir.Unit or Vector3.new(0, 0, -1) -- fallback direction when the vector is ~zero
	local spot = pos + dir * 3.2
	spot = Vector3.new(spot.X, floorAt(spot, {npc, prop.Parent :: Instance}) + 3.2, spot.Z)
	if walkTo(npc, spot) then
		local hrp = npc:FindFirstChild("HumanoidRootPart") :: BasePart?
		-- lookAt with the target's Y set to the NPC's own Y so he turns on the spot without tilting
		if hrp then hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(pos.X, hrp.Position.Y, pos.Z)) end
		wait(npc, math.random(15, 35), COOK, 7)
	end
	return true
end

local function actWander(npc: Model, S: ResidentState): boolean
	local room = S.rooms[math.random(#S.rooms)] -- math.random(0) would error, but #rooms is >= 1 for any spawned resident
	if not room then return false end
	S.activity = "wander"
	-- random offset inside the room, keeping a 2.5-stud margin from the walls on each side (room size - 5)
	local offset = Vector3.new((math.random() - 0.5) * math.max(room.w - 5, 0), 0, (math.random() - 0.5) * math.max(room.d - 5, 0))
	local target = room.centre + offset
	target = Vector3.new(target.X, floorAt(target, {npc, S.house:FindFirstChild("Furniture") :: Instance}) + 3.2, target.Z)
	walkTo(npc, target)
	if math.random() < 0.6 then say(npc, pick(SOLO)) end
	wait(npc, math.random(4, 10))
	return true
end

-- conversations: one walks over to another resident and they trade lines
local function actChat(npc: Model, S: ResidentState): boolean
	local partner: Model?
	for other, os_ in pairs(residents) do -- `os_` avoids shadowing the `os` library
		if other ~= npc and os_.house == S.house and os_.unit == S.unit and alive(other) and not busy(other)
			and os_.activity ~= "sleep" and os_.activity ~= "toilet" and os_.activity ~= "outside" and not os_.chatting then
			partner = other
			break
		end
	end
	if not partner then return false end
	S.activity = "chat"
	S.chatting = true
	residents[partner].chatting = true
	local pRoot = partner:FindFirstChild("HumanoidRootPart") :: BasePart?
	local root = npc:FindFirstChild("HumanoidRootPart") :: BasePart?
	if pRoot and root and flat(pRoot.Position, root.Position) > 5.5 then
		-- stand 4.2 studs from the partner, on the side he is already on (unit vector from partner to me, flattened)
		local toward = (root.Position - pRoot.Position) * Vector3.new(1, 0, 1)
		local stand = pRoot.Position + (toward.Magnitude > 0.1 and toward.Unit or Vector3.new(1, 0, 0)) * 4.2
		walkTo(npc, Vector3.new(stand.X, pRoot.Position.Y, stand.Z))
	end
	if not aborted(npc) and not aborted(partner) then
		-- face each other
		if pRoot and root then
			root.CFrame = CFrame.lookAt(root.Position, Vector3.new(pRoot.Position.X, root.Position.Y, pRoot.Position.Z))
			if not residents[partner].placed then -- do not rotate a partner who is anchored on a seat
				pRoot.CFrame = CFrame.lookAt(pRoot.Position, Vector3.new(root.Position.X, pRoot.Position.Y, root.Position.Z))
			end
		end
		for _ = 1, math.random(1, 3) do
			local pair = pick(PAIRS)
			say(npc, pair[1])
			if not wait(npc, 3.4) then break end
			say(partner, pair[2])
			if not wait(npc, 3.6) then break end
		end
	end
	S.chatting = false
	if residents[partner] then residents[partner].chatting = false end -- partner may have despawned meanwhile
	return true
end

-- the bartender works behind the bar, between the counter and the back bar shelves
local function actBartend(npc: Model, S: ResidentState): boolean
	local bar = S.props["Bar Counter"] and S.props["Bar Counter"][1]
	if not bar then return false end
	S.activity = "bartend"
	local counter = bar:GetPivot().Position
	local shelf = S.props["Back Bar Shelf"] and S.props["Back Bar Shelf"][1]
	local back = shelf and shelf:GetPivot().Position or (counter + Vector3.new(0, 0, 4))
	local middle = Vector3.new((counter.X + back.X) / 2, counter.Y, (counter.Z + back.Z) / 2) -- midpoint of the working lane
	-- (x, z) -> (-z, x) is a 90 degree rotation on the XZ plane: a vector running ALONG the counter
	local along = Vector3.new(-(back.Z - counter.Z), 0, back.X - counter.X)
	along = along.Magnitude > 0.1 and along.Unit or Vector3.new(1, 0, 0)
	local spot = middle + along * (math.random() * 6 - 3) -- random spot within +-3 studs along the counter
	spot = Vector3.new(spot.X, floorAt(spot, {npc, S.house:FindFirstChild("Furniture") :: Instance}) + 3.2, spot.Z)
	walkTo(npc, spot)
	local hrp = npc:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(counter.X, hrp.Position.Y, counter.Z)) end
	wait(npc, math.random(15, 40), BARTENDER, 11)
	return true
end

-- stepping outside through the front door (who has a key) and back in
-- Returns the doors whose INSIDE point (3 studs behind the door leaf) falls in this unit's power zone.
local function doorsOf(house: Model, unit: number): {Model}
	local list: {Model} = {}
	for _, d in ipairs(house:GetChildren()) do
		if d:IsA("Model") and CollectionService:HasTag(d, "HouseDoor") and d.PrimaryPart then
			list[#list + 1] = d
		end
	end
	local zone = zoneFor(house, unit)
	local mine: {Model} = {}
	for _, d in ipairs(list) do
		local pp = d.PrimaryPart :: BasePart
		-- LookVector points OUT of the house, so minus LookVector * 3 is a point just inside
		local inside = pp.Position - pp.CFrame.LookVector * 3
		if inZone(zone, inside + Vector3.new(0, 1, 0)) then mine[#mine + 1] = d end
	end
	return mine
end

-- `DoorControl` is a BindableEvent in ServerScriptService; Fire() triggers DoorServer's handler on the server side
local doorControl: BindableEvent?
local function setDoor(door: Model, action: "open" | "close")
	doorControl = doorControl or ServerScriptService:FindFirstChild("DoorControl") :: BindableEvent? -- cached after first lookup
	if doorControl then doorControl:Fire(door, action) end
end

local function goOutThenIn(npc: Model, S: ResidentState): boolean
	local doors = doorsOf(S.house, S.unit)
	local door = doors[1]
	if not door then return false end
	local leaf = door.PrimaryPart :: BasePart
	local out = leaf.CFrame.LookVector -- unit vector pointing away from the house
	local ignore: {Instance} = {npc, S.house:FindFirstChild("Furniture") :: Instance}
	local insideSpot = leaf.Position - out * 3.4
	local outsideSpot = leaf.Position + out * 4
	insideSpot = Vector3.new(insideSpot.X, floorAt(insideSpot, ignore) + 3.2, insideSpot.Z)
	outsideSpot = Vector3.new(outsideSpot.X, floorAt(outsideSpot, ignore) + 3.2, outsideSpot.Z)
	S.activity = "outside"
	if not walkTo(npc, insideSpot) then return true end
	setDoor(door, "open")
	task.wait(0.7) -- let the door swing before pathing through it
	walkTo(npc, outsideSpot)
	setDoor(door, "close")
	if not aborted(npc) then
		say(npc, pick({"Getting some air.", "Nice out. Well, nearly.", "Just popping out for a bit."}))
		wait(npc, math.random(8, 18))
	end
	-- back in
	if not aborted(npc) then
		setDoor(door, "open")
		task.wait(0.7)
		walkTo(npc, insideSpot)
		setDoor(door, "close")
	end
	return true
end

-- if he ends up outside the home (chased somebody out), he goes back in through his door
local function goHome(npc: Model, S: ResidentState)
	local root = npc:FindFirstChild("HumanoidRootPart") :: BasePart
	if inZone(S.zone, root.Position) then return end
	local door = doorsOf(S.house, S.unit)[1]
	if not door then return end
	local leaf = door.PrimaryPart :: BasePart
	local out = leaf.CFrame.LookVector
	local ignore: {Instance} = {npc, S.house:FindFirstChild("Furniture") :: Instance}
	local outsideSpot = leaf.Position + out * 4
	local insideSpot = leaf.Position - out * 3.4
	outsideSpot = Vector3.new(outsideSpot.X, floorAt(outsideSpot, ignore) + 3.2, outsideSpot.Z)
	insideSpot = Vector3.new(insideSpot.X, floorAt(insideSpot, ignore) + 3.2, insideSpot.Z)
	if walkTo(npc, outsideSpot) then
		setDoor(door, "open")
		task.wait(0.7)
		walkTo(npc, insideSpot)
		setDoor(door, "close")
	end
end

-- ===== the routine =====
-- "Daylight" is a Workspace attribute (0..1) published by WeatherServer; below 0.25 counts as night.
local function nightTime(): boolean
	local daylight = workspace:GetAttribute("Daylight")
	return type(daylight) == "number" and daylight < 0.25
end

local function pickActivity(S: ResidentState): Activity_fn
	if S.role == "bartender" then return actBartend end
	if S.upstairs then return choose({{8, actLounge}, {1, actChat}}) end
	local night = nightTime()
	-- weights are relative, not percentages: sleep is 5 at night vs 0.5 by day (10x likelier)
	local options: {{any}} = {
		{night and 0.8 or 2.4, actTV}, {2, actEat}, {2, actCook}, {1.4, actToilet},
		{night and 5 or 0.5, actSleep}, {2, actWander}, {2.2, actChat}, {0.6, goOutThenIn},
	}
	if S.house.Name:find("Pub") and (S.role ~= "landlord") then
		table.insert(options, {5, actPub})
	end
	return choose(options)
end

-- the routine of one resident, plus watching for strangers
-- `provoke` is supplied by the NPC brain: called with the intruder's character to start the fight.
function Life.start(npc: Model, provoke: (char: Model) -> ())
	local S = residents[npc]
	if not S then return end
	S.zone = zoneFor(S.house, S.unit)
	S.props = gather(S.house, S.unit)
	S.rooms = roomsOf(S.house, S.unit)
	S.seen = {}
	-- closure: centre of the room nearest to `pos` (flat distance)
	S.roomCentreOf = function(pos: Vector3): Vector3?
		local best: Vector3?, bestD: number?
		for _, r in ipairs(S.rooms) do
			local d = flat(r.centre, pos)
			if not bestD or d < bestD then best, bestD = r.centre, d end
		end
		return best
	end

	-- strangers (runs 2x per second on its own thread)
	task.spawn(function()
		local spotted = 0
		while npc.Parent and alive(npc) do
			task.wait(0.5)
			if not S.zone or not S.zone.Parent then S.zone = zoneFor(S.house, S.unit) end -- zone may stream in later
			if not npc:GetAttribute("Aggro") then
				for _, plr in ipairs(Players:GetPlayers()) do
					local char = plr.Character
					local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					-- a pub or shop is open to everyone: its people are only hostile to somebody with a bounty
					local publicPlace = S.house.Name:find("Pub") or S.house.Name:find("Corner Shop") or S.house:GetAttribute("ShopKind") ~= nil
					local unwelcome = (not publicPlace) or plr:GetAttribute("BountyActive")
					if unwelcome and root and hum and hum.Health > 0 and inZone(S.zone, root.Position) and Alert and Alert.canSee(npc, char :: Model, 34) then
						S.seen[plr] = (S.seen[plr] or 0) + 0.5 -- +0.5s per tick of visible trespass
						-- somebody asleep takes longer to notice
						local needed = S.activity == "sleep" and 3 or 1
						if S.seen[plr] >= needed then
							S.seen[plr] = 0
							if publicPlace then
								say(npc, pick({"Oi! You're the one they're after!", "Get out! I know who you are!", "Wanted, aren't you?!"}))
							else
								say(npc, pick(TRESPASS))
								Alert.crime(plr, 45, root.Position) -- spotted in somebody's home: they phone the police (heat 2)
							end
							provoke(char :: Model)
						end
					else
						S.seen[plr] = math.max((S.seen[plr] or 0) - 0.25, 0) -- suspicion decays when you are out of sight
					end
				end
				-- power cut: the PowerZone's "Dark" attribute is flipped by PowerServer
				if S.zone and S.zone:GetAttribute("Dark") and not S.reactedToDark then
					S.reactedToDark = true
					say(npc, pick(POWER))
				elseif S.zone and not S.zone:GetAttribute("Dark") then
					S.reactedToDark = false
				end
			end
		end
	end)

	-- the day
	task.spawn(function()
		task.wait(1 + math.random()) -- stagger so a whole street does not start in the same frame
		while npc.Parent and alive(npc) and not S.gone do
			if busy(npc) then
				task.wait(0.5)
			else
				goHome(npc, S)
				local activity = pickActivity(S)
				local ok, did = pcall(activity, npc, S) -- one bad activity must not kill the whole routine
				if not ok then warn("[ResidentLife] " .. tostring(did)) end
				S.activity = nil
				Life.release(npc, false)
				if not did then task.wait(1.5) end -- failed (no free prop): back off a moment
				wait(npc, 1.5 + math.random() * 3)
			end
		end
	end)
end

-- ===== spawning =====
local function countFor(house: Model): number
	if house.Name:find("Pub") then return 6 end
	if house.Name:find("Council") or house.Name:find("Shop") or house:GetAttribute("ShopKind") then return 2 end
	return math.random() < 0.55 and 2 or 1 -- 55% two residents, 45% one
end

function Life.spawn(house: Model, unit: number, role: ResidentRole, upstairs: boolean?): Model?
	local ServerNPCs = ServerStorage:FindFirstChild("NPCTemplates")
	local template = ServerNPCs and ServerNPCs:FindFirstChild("Resident") :: Model?
	if not template then return nil end
	folder = folder or (workspace:FindFirstChild("Residents") :: Folder?) or Instance.new("Folder")
	local f = folder :: Folder
	f.Name = "Residents"
	f.Parent = workspace

	local rooms = roomsOf(house, unit)
	if #rooms == 0 then return nil end
	local ground: {Room} = {}
	for _, r in ipairs(rooms) do if r.floor == 0 then ground[#ground + 1] = r end end
	local room = #ground > 0 and ground[math.random(#ground)] or rooms[1]
	if upstairs then
		local up: {Room} = {}
		for _, r in ipairs(rooms) do if r.floor == 1 then up[#up + 1] = r end end
		if #up > 0 then room = up[math.random(#up)] end
	end
	local pos = room.centre + Vector3.new((math.random() - 0.5) * math.max(room.w - 6, 0), 0, (math.random() - 0.5) * math.max(room.d - 6, 0))
	pos = Vector3.new(pos.X, floorAt(pos, {house:FindFirstChild("Furniture") :: Instance}) + 3.4, pos.Z)

	local npc = template:Clone()
	npc.Name = "Resident"
	npc:SetAttribute("NPCType", "Regular") -- tells the NPC brain which AI to run
	npc:SetAttribute("Unit", unit)
	residents[npc] = {house = house, unit = unit, role = role, props = {}, rooms = {}, upstairs = upstairs, seen = {}}
	local root = npc:FindFirstChild("HumanoidRootPart") :: BasePart
	-- PivotTo moves the whole model so that a chosen point lands exactly where we want.
	-- offset = pivot^-1 * root  (the root expressed in the pivot's local space, via ToObjectSpace)
	-- pivot' = CFrame.new(pos) * offset^-1  =>  pivot' * offset = CFrame.new(pos), i.e. the ROOT ends up at pos
	-- (the model's pivot is lower than the root, so pivoting straight to pos would sink him into the floor).
	npc:PivotTo(CFrame.new(pos) * npc:GetPivot():ToObjectSpace(root.CFrame):Inverse())
	npc.Parent = f -- parent LAST so scripts that read the start position see the final CFrame
	if role == "bartender" then
		npc:SetAttribute("Bartender", true)
		CollectionService:AddTag(npc, "Bartender") -- tag lets the BarServer find the bartender with GetTagged
	end
	-- Destroying fires BEFORE the instance is removed; mark the state gone so every running loop exits cleanly
	npc.Destroying:Connect(function()
		local S = residents[npc]
		if S then S.gone = true end
		if Occupancy then Occupancy.remove(npc) end
		residents[npc] = nil
	end)
	return npc
end

local function nearestPlayerDistance(position: Vector3): number
	local best = math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then best = math.min(best, (root.Position - position).Magnitude) end -- 3D distance
	end
	return best
end

local homes: {[Model]: {[number]: {Model}}} = {} -- [house] = {[unit] = {npcs}}

-- every house with room data, found once and then kept up to date (scanning the whole map every few seconds froze the server)
local houseList: {Model}, houseSet: {[Model]: boolean} = {}, {}
local function noteHouse(inst: Instance)
	if inst:IsA("Model") and not houseSet[inst] and inst:GetAttribute("RoomsJson") then
		houseSet[inst] = true
		houseList[#houseList + 1] = inst
	end
end
task.spawn(function()
	for _, d in ipairs(workspace:GetDescendants()) do -- one-off full scan, off the main thread
		noteHouse(d)
	end
end)
workspace.DescendantAdded:Connect(function(d: Instance)
	if d:IsA("Model") then task.defer(noteHouse, d) end -- defer: attributes may be set just after parenting
end)

function Life.manager()
	task.wait(3)
	while true do
		task.wait(1.2)
		local spawnBudget = 2 -- homes populated per pass: a whole street appearing at once made the server stall
		local count = 0
		for _ in pairs(residents) do count += 1 end
		-- iterate BACKWARDS so table.remove does not skip entries
		for index = #houseList, 1, -1 do
			local house: Model? = houseList[index]
			if house and not house.Parent then
				houseSet[house] = nil
				table.remove(houseList, index)
				house = nil
			end
			-- a house stripped of its furniture (nobody near) sends its residents away too
			if house and homes[house] and not house:FindFirstChild("Furniture") then
				for _, npcs in pairs(homes[house]) do
					for _, npc in ipairs(npcs) do
						if npc.Parent then npc:Destroy() end
					end
				end
				homes[house] = nil
			end
			if house and house:FindFirstChild("Furniture") and #(house :: Model).Furniture:GetChildren() > 0
				and not house:GetAttribute("Vacant") and not house:GetAttribute("HideoutOwner") then
				local dist = nearestPlayerDistance(house:GetPivot().Position)
				local entry = homes[house]
				if not entry then
					entry = {}
					homes[house] = entry
				end
				for unit = 1, (house:GetAttribute("Units") :: number?) or 1 do
					local npcs = entry[unit]
					if dist < SPAWN_RANGE and not npcs and spawnBudget > 0 and count < MAX_RESIDENTS and zoneFor(house, unit) then
						spawnBudget -= 1
						npcs = {}
						entry[unit] = npcs
						for i = 1, countFor(house) do
							-- first one is the owner (bartender in a pub); the rest are guests; pub guests 4+ go upstairs
							local role: ResidentRole = if i == 1 then (if house.Name:find("Pub") then "bartender" else "landlord") else "guest"
							local npc = Life.spawn(house, unit, role, house.Name:find("Pub") ~= nil and i >= 4)
							if npc then
								npcs[#npcs + 1] = npc
								count += 1
							end
						end
					elseif dist > DESPAWN_RANGE and npcs then
						for _, npc in ipairs(npcs) do
							if npc.Parent then npc:Destroy() end
						end
						entry[unit] = nil
					end
				end
			end
		end
	end
end

Life.residents = residents
return Life
