local FIGHT_LINES = {"Say that again!", "You what, mate?!", "Come on then!", "Pick on someone your own size!", "You owe me money!", "Stay down!", "Is that all you've got?"}
events.StreetFight = {weight = 3, run = function(ctx)
	local spot = sidewalkSpot(ctx:pos(), 45, 120)
	if not spot then return false end
	local a = spawnNpc("Regular", spot + Vector3.new(-1.5, 0, 0))
	local b = spawnNpc("Regular", spot + Vector3.new(1.5, 0, 0))
	if not a or not b then return false end
	ctx:track(a)
	ctx:track(b)
	face(a, b:GetPivot().Position)
	face(b, a:GetPivot().Position)
	if Alert then Alert.makeNoise(spot, 55) end
	ctx:hint(spot, 140, "You hear a fight kick off nearby.")

	local turn = 0
	local started = os.clock()
	while os.clock() - started < 28 and ctx:alive() do
		local attacker, defender = a, b
		if turn % 2 == 1 then attacker, defender = b, a end
		turn += 1
		local aRoot, dRoot, dHum = hrpOf(attacker), hrpOf(defender), humOf(defender)
		if not (aRoot and dRoot and dHum) then break end
		face(attacker, dRoot.Position)
		anim(attacker, "NPCSwing")
		if not ctx:wait(0.28) then break end
		if dHum.Health > 16 then dHum:TakeDamage(math.random(3, 6)) end
		local push = flat(dRoot.Position - aRoot.Position)
		if push.Magnitude > 0.1 then dRoot:ApplyImpulse(push.Unit * dRoot.AssemblyMass * 9) end
		hitSound(dRoot)
		if math.random() < 0.3 then say(attacker, pick(FIGHT_LINES), 2) end
		if not ctx:wait(0.6 + math.random() * 0.5) then break end
		face(defender, aRoot.Position)
	end

	if a.Parent and b.Parent then
		local loser, winner = a, b
		if (humOf(a) and humOf(b)) and humOf(a).Health > humOf(b).Health then loser, winner = b, a end
		anim(a, nil)
		anim(b, nil)
		if RagdollUtil then pcall(RagdollUtil.ragdollFor, loser, 4) end
		say(winner, pick({"Yeah! Stay down!", "Told you.", "Don't ever test me again."}), 3)
		ctx:wait(4)
		flee(winner, hrpOf(loser) and hrpOf(loser).Position or spot, 60, 14)
		ctx:wait(6)
	end
	return true
end}

local RIOT_LINES = {"NO JUSTICE, NO PEACE!", "Burn it down!", "Power to the people!", "Enough is enough!", "WHOSE STREETS?!", "We want answers!", "Down with the council!"}
events.Riot = {weight = 1, run = function(ctx)
	local spot = sidewalkSpot(ctx:pos(), 70, 140)
	if not spot then return false end
	local crowd = {}
	for i = 1, 9 do
		local at = groundPoint(spot + Vector3.new((math.random() - 0.5) * 18, 0, (math.random() - 0.5) * 18))
		local npc = spawnNpc(i % 3 == 0 and "Drunk" or "Regular", at, spot)
		if npc then
			ctx:track(npc)
			table.insert(crowd, npc)
		end
	end
	if #crowd < 3 then return false end
	if Alert then Alert.makeNoise(spot, 70) end
	ctx:hint(spot, 170, "Chanting and breaking glass echo down the street. A riot has broken out.")

	local ignite = ServerScriptService:FindFirstChild("IgniteTarget")
	local started = os.clock()
	local nextDamage, nextLine, nextNoise = os.clock() + 4, os.clock() + 2, os.clock() + 6
	while os.clock() - started < 55 and ctx:alive() do
		for _, npc in ipairs(crowd) do
			if npc.Parent and math.random() < 0.45 then
				anim(npc, pick({"Cheer", "Shout", "Cheer"}))
				local hum = humOf(npc)
				if hum and math.random() < 0.5 then
					hum.WalkSpeed = 15
					hum:MoveTo(groundPoint(spot + Vector3.new((math.random() - 0.5) * 24, 0, (math.random() - 0.5) * 24)))
				end
			end
		end
		if os.clock() > nextLine then
			nextLine = os.clock() + 2.5
			say(pick(crowd), pick(RIOT_LINES), 2.5)
		end
		if os.clock() > nextNoise then
			nextNoise = os.clock() + 8
			if Alert then Alert.makeNoise(spot, 60) end
		end
		if os.clock() > nextDamage and Destructibles then
			nextDamage = os.clock() + 5
			local params = OverlapParams.new()
			for _, part in ipairs(workspace:GetPartBoundsInRadius(spot, 30, params)) do
				local prop = Destructibles.of and Destructibles.of(part)
				if prop and not prop:GetAttribute("Held") then
					pcall(Destructibles.damage, prop, 70, nil, "npc")
					if ignite and prop.Parent and CollectionService:HasTag(prop, "Flammable") and math.random() < 0.4 then ignite:Fire(prop) end
					break
				end
			end
		end
		if not ctx:wait(1.5) then break end
	end

	for _, npc in ipairs(crowd) do
		anim(npc, nil)
		flee(npc, spot, 90, 20)
	end
	ctx:wait(7)
	return true
end}

events.Mugging = {weight = 2, run = function(ctx)
	local spot = sidewalkSpot(ctx:pos(), 40, 110)
	if not spot then return false end
	local victim = spawnNpc("Coward", spot)
	local thug = spawnNpc("Regular", spot + Vector3.new(3.2, 0, 0))
	if not victim or not thug then return false end
	ctx:track(victim)
	ctx:track(thug)
	face(victim, thug:GetPivot().Position)
	face(thug, victim:GetPivot().Position)
	anim(victim, "HandsUp")
	anim(thug, "Shout")
	ctx:hint(spot, 120, "Someone nearby is being mugged.")
	say(thug, pick({"Wallet. Now.", "Hand it over, nice and slow.", "Don't be a hero. Wallet."}), 3)
	say(victim, pick({"Please, I've got kids!", "Take it, take it!", "Don't hurt me!"}), 3)

	local stopped = false
	local started = os.clock()
	while os.clock() - started < 14 and ctx:alive() do
		local thugRoot = hrpOf(thug)
		local playerPos = ctx:pos()
		if not thugRoot or (humOf(thug) and humOf(thug).Health < humOf(thug).MaxHealth * 0.9) then stopped = true break end
		if playerPos and (playerPos - thugRoot.Position).Magnitude < 11 then stopped = true break end
		if not ctx:wait(0.4) then break end
	end

	if stopped then
		anim(thug, nil)
		say(thug, pick({"Mind your own business!", "Not worth it. Leg it!", "You didn't see anything!"}), 3)
		flee(thug, ctx:pos() or spot, 90, 24)
		anim(victim, nil)
		say(victim, "Thank you, thank you! Here, take this.", 3)
		local cash = ctx.player:FindFirstChild("Cash")
		local reward = math.random(10, 35)
		if cash then cash.Value += reward end
		notify(ctx.player, "You scared off a mugger. The victim gives you $" .. reward)
	elseif ctx:alive() then
		anim(thug, "NPCSwing")
		ctx:wait(0.35)
		anim(victim, nil)
		if RagdollUtil then pcall(RagdollUtil.ragdollFor, victim, 3) end
		say(victim, "HELP! I've been robbed!", 3)
		flee(thug, hrpOf(victim) and hrpOf(victim).Position or spot, 100, 22)
	end
	ctx:wait(8)
	return true
end}

events.PlayerMugging = {weight = 1.5, run = function(ctx)
	local playerPos = ctx:pos()
	local cash = ctx.player:FindFirstChild("Cash")
	if not playerPos or not cash or cash.Value < 10 then return false end
	local spot = sidewalkSpot(playerPos, 35, 70)
	if not spot then return false end
	local thug = spawnNpc("Regular", spot, playerPos)
	if not thug then return false end
	ctx:track(thug)
	local hum, root = humOf(thug), hrpOf(thug)
	if not hum or not root then return false end
	hum.WalkSpeed = 15

	local arrived = false
	local started = os.clock()
	while os.clock() - started < 30 and ctx:alive() and thug.Parent and hum.Health > 0 do
		local p = ctx:pos()
		if not p then break end
		if (p - root.Position).Magnitude < 6.5 then arrived = true break end
		hum:MoveTo(p)
		ctx:wait(0.4)
	end
	if not arrived or hum.Health <= 0 then return true end

	hum:MoveTo(root.Position)
	face(thug, ctx:pos())
	anim(thug, "Shout")
	say(thug, pick({"Oi! Empty your pockets!", "Cash. Now. Don't make this messy.", "Hand it over, mate."}), 3)
	notify(ctx.player, "A mugger wants your cash! Fight him, or run!")

	local gaveUp = false
	local waitStart = os.clock()
	while os.clock() - waitStart < 9 and ctx:alive() do
		if hum.Health <= 0 then break end
		face(thug, ctx:pos())
		local p = ctx:pos()
		if p and (p - root.Position).Magnitude > 22 then gaveUp = true break end
		ctx:wait(0.3)
	end
	if hum.Health <= 0 or not thug.Parent then
		notify(ctx.player, "You put the mugger down.")
		return true
	end
	if gaveUp then
		anim(thug, nil)
		say(thug, "Forget it. Not worth the hassle.", 3)
		return true
	end

	anim(thug, "NPCSwing")
	ctx:wait(0.3)
	local stolen = math.min(cash.Value, math.max(5, math.floor(cash.Value * 0.15)))
	cash.Value -= stolen
	notify(ctx.player, "The mugger took $" .. stolen .. " and ran. Catch him to get it back!")
	say(thug, "Cheers for the donation!", 3)
	local player = ctx.player
	hum.Died:Once(function()
		if player.Parent then
			local c = player:FindFirstChild("Cash")
			if c then c.Value += stolen end
			notify(player, "You got your $" .. stolen .. " back.")
		end
	end)
	flee(thug, ctx:pos() or root.Position, 160, 22)
	ctx:wait(30)
	return true
end}

local CRASH_LINES = {"WHERE DID YOU LEARN TO DRIVE?!", "You came out of nowhere!", "Look at my car!", "I had right of way!", "My insurance is going to love this.", "Are you blind?!"}
local function pathLength(points)
	local length = 0
	for i = 2, #points do length += flat(points[i] - points[i - 1]).Magnitude end
	return length
end
events.CarCrash = {weight = 1.5, run = function(ctx)
	if not (Vehicles and RoadNetwork) then return false end
	local here = ctx:pos()
	local route
	for _ = 1, 8 do
		local node = RoadNetwork.nodeBetween(here, 80, 170)
		if node then
			local nbs = RoadNetwork.neighbours(node)
			if #nbs >= 2 then
				local i = math.random(#nbs)
				local j = (i % #nbs) + 1
				local function build(from)
					local pts = RoadNetwork.pointsFor({from, node})
					if #pts < 2 then return nil end
					local dir = flat(pts[#pts] - pts[#pts - 1])
					if dir.Magnitude < 0.1 then return nil end
					table.insert(pts, pts[#pts] + dir.Unit * 45)
					return pts
				end
				local a, b = build(nbs[i]), build(nbs[j])
				if a and b and not (Visibility and (Visibility.seen(a[1]) or Visibility.seen(b[1]))) then
					route = {a = a, b = b, center = RoadNetwork.nodePosition(node)}
					break
				end
			end
		end
	end
	if not route then return false end

	local okA, carA = pcall(Vehicles.new, "Civilian", Vehicles.startCFrame(route.a))
	local okB, carB = pcall(Vehicles.new, "Civilian", Vehicles.startCFrame(route.b))
	if not okA or not okB then
		if okA then pcall(function() carA:destroy() end) end
		if okB then pcall(function() carB:destroy() end) end
		return false
	end
	ctx:track(carA)
	ctx:track(carB)
	pcall(function() carA:seatNpcDriver() end)
	pcall(function() carB:seatNpcDriver() end)

	local speed = 40
	local lenA, lenB = pathLength(route.a), pathLength(route.b)
	local function launch(car, points, delay)
		if delay <= 0.05 then
			car:drive(points, speed)
		else
			task.delay(delay, function()
				if car.body and car.body.Parent then car:drive(points, speed) end
			end)
		end
	end
	launch(carA, route.a, (lenB - lenA) / speed)
	launch(carB, route.b, (lenA - lenB) / speed)

	ctx:hint(route.center, 190, "Tyres screech somewhere ahead.")
	local started = os.clock()
	local crashed = false
	while os.clock() - started < math.max(lenA, lenB) / speed + 8 and ctx:alive() do
		if carA.body and carB.body and carA.body.Parent and carB.body.Parent then
			local pa, pb = carA.body.Position, carB.body.Position
			if (pa - pb).Magnitude < 11 or (flat(pa - route.center).Magnitude < 7 and flat(pb - route.center).Magnitude < 22) or (flat(pb - route.center).Magnitude < 7 and flat(pa - route.center).Magnitude < 22) then
				crashed = true
				break
			end
		end
		task.wait(0.1)
	end
	if not crashed then return true end

	local mid = (carA.body.Position + carB.body.Position) / 2
	for _, car in ipairs({carA, carB}) do
		pcall(function() car:dent(mid, 1.4) end)
		pcall(function() car:breakGlass(mid, 1.2) end)
		pcall(function() car:damage(55) end)
		pcall(function() car:coastToStop() end)
	end
	if Alert then Alert.makeNoise(mid, 90) end
	ctx:wait(1.2)

	local drivers = {}
	for _, car in ipairs({carA, carB}) do
		local ok, rig = pcall(function() return car:ejectNpcDriver() end)
		if ok and rig then
			rig:SetAttribute("BenchBusy", true)
			rig:SetAttribute("EventNPC", true)
			ctx:track(rig)
			table.insert(drivers, rig)
		end
	end
	ctx:wait(1)
	local talkUntil = os.clock() + 22
	while os.clock() < talkUntil and ctx:alive() do
		for n, rig in ipairs(drivers) do
			if rig.Parent then
				local other = drivers[(n % #drivers) + 1]
				if other and other.Parent and other ~= rig then face(rig, other:GetPivot().Position) end
				anim(rig, "Argue")
				say(rig, pick(CRASH_LINES), 3)
			end
		end
		ctx:wait(3.5)
	end
	for _, rig in ipairs(drivers) do anim(rig, nil) end
	ctx:wait(25)
	return true
end}

