	local awayFor = 0
	local step = 0
	while os.clock() - started < 170 and ctx:alive() do
		step += 1
		lights[1].Color = colours[(step % #colours) + 1]
		lights[2].Color = colours[((step + 2) % #colours) + 1]
		if not told and ctx:near(centre, 170) then
			told = true
			notify(ctx.player, "You can hear a party going on nearby.")
		end
		if step % 12 == 0 then
			for _, g in ipairs(guests) do
				if g.Parent then
					anim(g, pick({"Dance", "Dance", "Cheer"}))
					if math.random() < 0.25 then say(g, pick(PARTY_LINES), 2.5) end
				end
			end
		end
		if ctx:near(centre, 330) then awayFor = 0 else awayFor += 0.4 if awayFor > 25 then break end end
		task.wait(0.4)
	end
	TweenService:Create(music, TweenInfo.new(2), {Volume = 0}):Play()
	for _, g in ipairs(guests) do anim(g, nil) end
	ctx:wait(2.5)
	return true
end}

local CONVOS = {
