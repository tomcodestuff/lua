local function pick(list) return list[math.random(#list)] end
local function flat(v) return Vector3.new(v.X, 0, v.Z) end

local function rootOf(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then return root end
	return nil
end

local function notify(player, text)
	if Progression and player then Progression.notify(player, text) end
end

local function say(npc, text, seconds)
	if Speech and npc and npc.Parent then pcall(Speech.say, npc, text, seconds or 3) end
end

local function hrpOf(npc) return npc and npc:FindFirstChild("HumanoidRootPart") end
local function humOf(npc) return npc and npc:FindFirstChildOfClass("Humanoid") end

local function groundPoint(position)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {npcFolder, workspace:FindFirstChild("Debris") or npcFolder}
	local hit = workspace:Raycast(position + Vector3.new(0, 25, 0), Vector3.new(0, -80, 0), params)
	return hit and hit.Position or position
end

local function face(npc, target)
	local root = hrpOf(npc)
	if not root then return end
	local from = root.Position
	local to = Vector3.new(target.X, from.Y, target.Z)
	if (to - from).Magnitude < 0.05 then return end
	root.CFrame = CFrame.lookAt(from, to)
end

local function anim(npc, name)
	if not npc or not npc.Parent then return end
	CollectionService:AddTag(npc, "NPCAnimated")
	npc:SetAttribute("NPCAnimN", (npc:GetAttribute("NPCAnimN") or 0) + 1)
	npc:SetAttribute("NPCAnim", name)
end

local leftovers = {}

local function spawnNpc(templateName, position, lookAt)
	local template = templates:FindFirstChild(templateName)
	if not template then return nil end
	local npc = template:Clone()
	local yaw = math.rad(math.random(0, 359))
	local cf = CFrame.new(position + Vector3.new(0, 3.5, 0)) * CFrame.Angles(0, yaw, 0)
	if lookAt then cf = CFrame.lookAt(cf.Position, Vector3.new(lookAt.X, cf.Position.Y, lookAt.Z)) end
	npc:PivotTo(cf)
	npc:SetAttribute("BenchBusy", true)
	npc:SetAttribute("EventNPC", true)
	npc.Parent = npcFolder
	local hum = humOf(npc)
	if hum then npc:SetAttribute("BaseSpeed", hum.WalkSpeed) end
	return npc
end

local function release(npc)
	if not npc or not npc.Parent then return end
	anim(npc, nil)
	npc:SetAttribute("BenchBusy", nil)
	npc:SetAttribute("EventNPC", nil)
	local hum = humOf(npc)
	if hum and npc:GetAttribute("BaseSpeed") then hum.WalkSpeed = npc:GetAttribute("BaseSpeed") end
	leftovers[npc] = os.clock()
end

local function sidewalkSpot(center, minD, maxD)
	local parts = Sidewalk.sidewalksNear(center, maxD)
	if #parts == 0 then return nil end
	for _ = 1, 30 do
		local part = parts[math.random(#parts)]
		if part and part:IsA("BasePart") then
			local pos = Sidewalk.randomPoint(part)
			local d = flat(pos - center).Magnitude
			if d >= minD and d <= maxD and not (Visibility and Visibility.seen(pos)) then return pos end
		end
	end
	return nil
end

local function makeContext(player)
	local ctx = {player = player, actors = {}, ended = false}
	function ctx:pos()
		local root = rootOf(player)
		return root and root.Position or nil
	end
	function ctx:alive()
		return not self.ended and player.Parent ~= nil and rootOf(player) ~= nil
	end
	function ctx:wait(seconds)
		local untilTime = os.clock() + seconds
		while os.clock() < untilTime do
			if not self:alive() then return false end
			task.wait(math.min(0.2, math.max(untilTime - os.clock(), 0.03)))
		end
		return self:alive()
	end
	function ctx:track(thing)
		table.insert(self.actors, thing)
		return thing
	end
	function ctx:near(position, range)
		local p = self:pos()
		return p ~= nil and (p - position).Magnitude <= range
	end
	function ctx:hint(position, range, text)
		if self:near(position, range) then notify(player, text) end
	end
	function ctx:finish()
		self.ended = true
		for _, actor in ipairs(self.actors) do
			if typeof(actor) == "Instance" then
				if actor:GetAttribute("EventNPC") then release(actor) else actor:Destroy() end
			elseif type(actor) == "table" then
				pcall(function() actor:destroy() end)
			elseif type(actor) == "function" then
				pcall(actor)
			end
		end
		self.actors = {}
	end
	return ctx
end

local function flee(npc, from, distance, speed)
	local hum, root = humOf(npc), hrpOf(npc)
	if not hum or not root then return end
	local dir = flat(root.Position - from)
	if dir.Magnitude < 0.1 then dir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
	hum.WalkSpeed = speed or 20
	hum:MoveTo(root.Position + dir.Unit * (distance or 80))
end

local function hitSound(root)
	if FightSounds and FightSounds.Hit and root then pcall(FightSounds.play3D, FightSounds.Hit, root, 0.8) end
end

