				local nearest = math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					local r = rootOf(p)
					if r and root then nearest = math.min(nearest, (r.Position - root.Position).Magnitude) end
				end
				if os.clock() - since > 240 or nearest > 260 then
					if not (Visibility and root and Visibility.seen(root.Position)) then
						leftovers[npc] = nil
						npc:Destroy()
					end
				end
			end
		end
	end
end)

